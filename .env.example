# Phishing Sense — Frontend environment variables
# Copy this file to `.env` and fill in your values.
# Expo requires the `EXPO_PUBLIC_` prefix to expose variables to the bundle.

# Backend API base URL used by the mobile app
# Use your machine's local IP for development so physical phones can reach it:
#   Windows: ipconfig | findstr IPv4
#   macOS/Linux: ifconfig or ip addr show
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.106:3000

# Supabase project credentials (anon key is client-safe; keep service role key secret)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
