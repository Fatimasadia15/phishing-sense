{
  "expo": {
    "name": "Phishing Sense",
    "slug": "phishing-sense",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "phishingsense",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F8F8FF",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phishingsense.app"
    },
    "android": {
      "package": "com.phishingsense.app",
      "adaptiveIcon": {
        "backgroundColor": "#9FA1FF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Phishing Sense needs microphone access to listen to suspicious messages you want to check.",
          "speechRecognitionPermission": "Phishing Sense needs speech recognition to convert your voice to text for scam analysis."
        }
      ]
    ]
  }
}
