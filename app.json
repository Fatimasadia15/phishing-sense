      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNjYWNmanFrdWlrbHdzanVmcmlpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgwODUzNTYsImV4cCI6MjEwMzY2MTM1Nn0.Y99sqe1arazi9V6tXDSjjasI64VB_SN8J2QXBnE4rnw"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Phishing Sense needs microphone access to listen to suspicious messages you want to check.",
