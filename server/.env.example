# ─────────────────────────────────────────────────────────────
#  Phishing Sense — Backend Environment Configuration
#  Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated allowed origins. Leave empty for local dev defaults.
CORS_ORIGIN=

# Body parsing limit in bytes (should match MAX_INPUT_LENGTH)
MAX_BODY_SIZE=5000

# Logging level — "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# LLM Provider — "openai" | "none"
# When set to "none", only the rule-based engine runs.
LLM_PROVIDER=none

# OpenAI-compatible API (works with OpenAI, Azure, local models)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Maximum request body size (bytes)
MAX_INPUT_LENGTH=5000

# Supabase (PostgreSQL database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
